@page "/products"
@using System.ComponentModel
@using R5A08_Client.ViewModels
@implements IDisposable
@inject ProductsViewModel ViewModel

<PageTitle>Products - R5A08 Quality</PageTitle>

<div class="mb-4">
    <h1 class="h2 fw-bold mb-1">Product Management</h1>
    <p class="mb-0" style="color: #948b89;">Search, filter and manage product items</p>
</div>

<div class="row my-3">
    <div class="col-md-6">
        <div class="input-group">
            <input type="text" class="form-control" placeholder="Search by name..."
                   @bind="ViewModel.SearchName" @bind:event="oninput" />
            <button class="btn btn-search" @onclick="ViewModel.SearchByNameAsync">Search</button>
            <button class="btn btn-reset" @onclick="ViewModel.ResetAsync">Reset</button>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(ViewModel.Message))
{
    <div class="alert alert-info mb-3">
        <span>@ViewModel.Message</span>
    </div>
}

@if (ViewModel.IsLoading)
{
    <div class="my-4">
        <span style="color: #948b89;">Loading products...</span>
    </div>
}
else if (ViewModel.Products != null)
{
    <div class="card overflow-hidden mb-4">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th style="width: 80px;">ID</th>
                        <th>Name</th>
                        <th>Description</th>
                        <th>Brand</th>
                        <th>Type</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!ViewModel.Products.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4" style="color: #948b89;">No products found.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in ViewModel.Products)
                        {
                            <tr>
                                <td class="fw-semibold">#@item.Id</td>
                                <td class="fw-medium">@item.Name</td>
                                <td style="color: #948b89;">@(string.IsNullOrEmpty(item.Description) ? "-" : item.Description)</td>
                                <td><span class="badge badge-brand">@item.Brand</span></td>
                                <td><span class="badge badge-type">@item.ProductType</span></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<div class="card p-4 my-4">
    <h3 class="h5 fw-semibold mb-3">Add New Product</h3>
    <EditForm Model="ViewModel.NewProduct" OnValidSubmit="ViewModel.AddProductAsync">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Product Name</label>
                <InputText class="form-control" @bind-Value="ViewModel.NewProduct.Name" placeholder="Enter product name" />
                <ValidationMessage For="() => ViewModel.NewProduct.Name" />
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">Description</label>
                <InputText class="form-control" @bind-Value="ViewModel.NewProduct.Description" placeholder="Enter description" />
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Product Type</label>
                <InputSelect class="form-select" @bind-Value="ViewModel.NewProduct.ProductTypeId">
                    <option value="0">-- Select type --</option>
                    @foreach (var type in ViewModel.ProductTypes)
                    {
                        <option value="@type.Id">@type.Name</option>
                    }
                </InputSelect>
                <ValidationMessage For="() => ViewModel.NewProduct.ProductTypeId" />
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">Brand</label>
                <InputSelect class="form-select" @bind-Value="ViewModel.NewProduct.BrandId">
                    <option value="0">-- Select brand --</option>
                    @foreach (var brand in ViewModel.Brands)
                    {
                        <option value="@brand.Id">@brand.Name</option>
                    }
                </InputSelect>
                <ValidationMessage For="() => ViewModel.NewProduct.BrandId" />
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Photo Name</label>
                <InputText class="form-control" @bind-Value="ViewModel.NewProduct.PhotoName" placeholder="photo.png" />
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">Photo URI</label>
                <InputText class="form-control" @bind-Value="ViewModel.NewProduct.PhotoUri" placeholder="https://..." />
            </div>
        </div>

        <button type="submit" class="btn btn-success mt-2" disabled="@ViewModel.IsLoading">
            Create Product
        </button>
    </EditForm>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        ViewModel.PropertyChanged += OnViewModelChanged;
        await ViewModel.LoadDataAsync();
    }

    private void OnViewModelChanged(object? sender, PropertyChangedEventArgs e) => InvokeAsync(StateHasChanged);
    public void Dispose() => ViewModel.PropertyChanged -= OnViewModelChanged;
}