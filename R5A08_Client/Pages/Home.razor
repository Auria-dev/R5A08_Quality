@page "/"

<PageTitle>Home - R5A08 Quality</PageTitle>

<div class="mb-4">
    <h1 class="fw-bold display-6 mb-2">Welcome to R5A08 Quality</h1>
    <p class="fs-5" style="color: #948b89;">A simple, flat management portal built with Blazor.</p>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card p-4 h-100">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <span class="fw-semibold text-uppercase fs-6" style="color: #948b89;">Catalog</span>
                <span class="badge">Products</span>
            </div>
            <h3 class="h5 fw-semibold">Products</h3>
            <p class="small mb-3" style="color: #948b89;">Manage items, search by name, filter by brand & type.</p>
            <a href="products" class="btn btn-secondary btn-sm mt-auto">
                View Products
            </a>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-4 h-100">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <span class="fw-semibold text-uppercase fs-6" style="color: #948b89;">Brands</span>
                <span class="badge">Manufacturers</span>
            </div>
            <h3 class="h5 fw-semibold">Brands</h3>
            <p class="small mb-3" style="color: #948b89;">Register and inspect manufacturer and brand records.</p>
            <a href="brands" class="btn btn-secondary btn-sm mt-auto">
                View Brands
            </a>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-4 h-100">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <span class="fw-semibold text-uppercase fs-6" style="color: #948b89;">Taxonomy</span>
                <span class="badge">Categories</span>
            </div>
            <h3 class="h5 fw-semibold">Product Types</h3>
            <p class="small mb-3" style="color: #948b89;">Organize product taxonomy and categories efficiently.</p>
            <a href="producttypes" class="btn btn-secondary btn-sm mt-auto">
                View Types
            </a>
        </div>
    </div>
</div>
