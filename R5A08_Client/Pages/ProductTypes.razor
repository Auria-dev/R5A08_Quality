@page "/producttypes"
@using System.ComponentModel
@using R5A08_Client.ViewModels
@implements IDisposable
@inject ProductTypesViewModel ViewModel

<PageTitle>Product Types - R5A08 Quality</PageTitle>

<div class="mb-4">
    <h1 class="h2 fw-bold mb-0">Product Types</h1>
</div>

@if (!string.IsNullOrEmpty(ViewModel.Message))
{
    <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
        <span>@ViewModel.Message</span>
        <button type="button" class="btn-close" @onclick="() => ViewModel.Message = null"></button>
    </div>
}

@if (!string.IsNullOrEmpty(ViewModel.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
        <strong>Validation / Operation Error:</strong>
        <div>@ViewModel.ErrorMessage</div>
        <button type="button" class="btn-close" @onclick="() => ViewModel.ErrorMessage = null"></button>
    </div>
}

@if (ViewModel.IsLoading && (ViewModel.ProductTypes == null || !ViewModel.ProductTypes.Any()))
{
    <div class="my-4">
        <span style="color: #948b89;">Loading product types...</span>
    </div>
}
else if (ViewModel.ProductTypes != null)
{
    <div class="card overflow-hidden mb-4">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th style="width: 120px; cursor: pointer;" class="user-select-none" @onclick='() => ViewModel.SortBy("Id")'>
                            ID <span class="ms-1 small text-muted">@ViewModel.GetSortIcon("Id")</span>
                        </th>
                        <th style="cursor: pointer;" class="user-select-none" @onclick='() => ViewModel.SortBy("Name")'>
                            Product Type Name <span class="ms-1 small text-muted">@ViewModel.GetSortIcon("Name")</span>
                        </th>
                        <th style="width: 180px;" class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!ViewModel.ProductTypes.Any())
                    {
                        <tr>
                            <td colspan="3" class="text-center py-4" style="color: #948b89;">No product types found.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in ViewModel.ProductTypes)
                        {
                            if (ViewModel.EditingProductTypeId == item.Id)
                            {
                                <tr>
                                    <td class="fw-semibold">#@item.Id</td>
                                    <td>
                                        <EditForm Model="ViewModel.EditingProductType" OnValidSubmit="ViewModel.UpdateProductTypeAsync">
                                            <DataAnnotationsValidator />
                                            <div class="input-group input-group-sm">
                                                <InputText class="form-control form-control-sm" @bind-Value="ViewModel.EditingProductType.Name" placeholder="Product type name..." />
                                                <button type="submit" class="btn btn-sm btn-primary">Save</button>
                                                <button type="button" class="btn btn-sm btn-secondary" @onclick="ViewModel.CancelEdit">Cancel</button>
                                            </div>
                                            <ValidationMessage For="() => ViewModel.EditingProductType.Name" class="text-danger small" />
                                        </EditForm>
                                    </td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => ViewModel.DeleteProductTypeAsync(item.Id)">
                                            Delete
                                        </button>
                                    </td>
                                </tr>
                            }
                            else
                            {
                                <tr>
                                    <td class="fw-semibold">#@item.Id</td>
                                    <td class="fw-medium">@item.Name</td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => ViewModel.StartEdit(item)">
                                            Edit
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => ViewModel.DeleteProductTypeAsync(item.Id)">
                                            Delete
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<div class="card p-4 my-4">
    <h3 class="h5 fw-semibold mb-3">Add New Product Type</h3>
    <EditForm Model="ViewModel.NewProductType" OnValidSubmit="ViewModel.AddProductTypeAsync">
        <DataAnnotationsValidator />
        <ValidationSummary class="text-danger mb-3" />

        <div class="mb-3">
            <label class="form-label">Product Type Name</label>
            <InputText class="form-control" @bind-Value="ViewModel.NewProductType.Name" placeholder="Enter product type name" />
            <ValidationMessage For="() => ViewModel.NewProductType.Name" class="text-danger small mt-1" />
        </div>

        <button type="submit" class="btn btn-success" disabled="@ViewModel.IsLoading">
            Create Product Type
        </button>
    </EditForm>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        ViewModel.PropertyChanged += OnViewModelChanged;
        await ViewModel.LoadDataAsync();
    }

    private void OnViewModelChanged(object? sender, PropertyChangedEventArgs e) => InvokeAsync(StateHasChanged);
    public void Dispose() => ViewModel.PropertyChanged -= OnViewModelChanged;
}
